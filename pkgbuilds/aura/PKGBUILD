# Image compatibility package built from omacom/m1n1. Updates refresh ESP Stage 2;
# Stage 1 enrollment remains an explicit installer/Recovery operation.
pkgname=aura
pkgver=0.1.0.r20261022
pkgrel=2
pkgdesc='Omarchy Apple Silicon bootloader from omacom/m1n1'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/omacom/m1n1'
license=('MIT' 'GPL-2.0-only')
_commit=12a2762b0020cbbe35833367e75ae80af81c82a7
_compat=1.6.1.aurora19
provides=("m1n1=$_compat" "m1n1-aurora=$_compat" "m1n1-neo=$_compat")
conflicts=('m1n1' 'm1n1-aurora' 'm1n1-neo')
replaces=('m1n1-neo')
makedepends=('git' 'clang' 'lld' 'llvm' 'rustup' 'make' 'python')
options=('!strip' '!debug')
source=("m1n1::git+$url.git#commit=$_commit" build-qualification.json validate-qualification.py)
sha256sums=('SKIP'
            '1c692a119e39919ee563bd3612ae528ee51acf6065ab957a7c056c58e2a8d01a'
            'd89f89a68105e4663bdf14bf9d4d70f3fad79538a4c566e8fae73c0b40a9be26')
prepare() {
  rustup toolchain install 1.89.0 --profile minimal --target aarch64-unknown-none-softfloat
  [[ $(git -C m1n1 rev-parse HEAD) == "$_commit" ]]
}
build() {
  cd m1n1
  export RUSTUP_TOOLCHAIN=1.89.0
  make clean
  # Keep the complete file below the existing DCP log-buffer limit.
  make -j"${OMARCHY_BUILD_JOBS:-10}" EXTRA_CFLAGS=-Os RELEASE=1 CHAINLOADING=1 USE_CLANG=1 BUILTIN_LOGO=aurora
  install -Dm644 build/m1n1.bin "$srcdir/stage1/aura-raw.bin"
  install -Dm644 build/m1n1.macho "$srcdir/stage1/aura.macho"
  make clean
  make -j"${OMARCHY_BUILD_JOBS:-10}" EXTRA_CFLAGS=-Os RELEASE=1 CHAINLOADING=1 ESP_STAGE2=1 USE_CLANG=1 BUILTIN_LOGO=aurora
}
package() {
  # Required on the installed system, not to build the bootloader.
  depends=('asahi-scripts>=20260127.1' 'uboot-aurora')
  # Building a PR candidate does not assert release/hardware qualification.
  python "$srcdir/validate-qualification.py" --build-only "$srcdir/build-qualification.json" "$_commit"
  install -Dm644 m1n1/build/m1n1.bin "$pkgdir/usr/lib/asahi-boot/m1n1.bin"
  install -d "$pkgdir/usr/lib/m1n1-neo"
  ln -s ../asahi-boot/m1n1.bin "$pkgdir/usr/lib/m1n1-neo/m1n1.bin"
  install -Dm644 stage1/aura-raw.bin "$pkgdir/usr/share/aura/stage1/aura-raw.bin"
  install -Dm644 stage1/aura.macho "$pkgdir/usr/share/aura/stage1/aura.macho"
  install -Dm644 m1n1/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -m644 m1n1/3rdparty_licenses/* "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 "$srcdir/build-qualification.json" "$pkgdir/usr/share/doc/aura/build-qualification.json"
}
